{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 2,
      "left": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m󰋗 System Information"
    },
    {
      "type": "custom",
      "format": "\u001b[35m========================================="
    },
    // --- OS SECTION ---
    {
      "type": "custom",
      "format": "\u001b[31m▢ OS"
    },
    {
      "type": "os",
      "key": "  \u001b[31m├─ 󱄅 Distro \u001b[39m>",
      "format": "{name} {version}, btw"
    },
    {
    "type": "packages",
    "key": "  \u001b[31m├─ 󰏗 Packages \u001b[39m>",
    },
    {
      "type": "kernel",
      "key": "  \u001b[31m└─  Kernel \u001b[39m>"
    },
    // --- DESKTOP ENVIRONMENT SECTION ---
    {
      "type": "custom",
      "format": "\u001b[32m▢ Desktop Environment"
    },
    {
      "type": "wm",
      "key": "  \u001b[32m├─  WM \u001b[39m>"
    },
    {
      "type": "wmtheme",
      "key": "  \u001b[32m└─ 󰉼 Theme \u001b[39m>"
    },
    // --- TERMINAL SECTION ---
    {
      "type": "custom",
      "format": "\u001b[33m▢ Terminal"
    },
    {
      "type": "shell",
      "key": "  \u001b[33m├─  Shell \u001b[39m>"
    },
    {
      "type": "terminal",
      "key": "  \u001b[33m└─  Term \u001b[39m>"
    },
    // --- HARDWARE SECTION ---
    {
      "type": "custom",
      "format": "\u001b[34m▢ Hardware"
    },
    {
      "type": "cpu",
      "key": "  \u001b[34m├─  CPU \u001b[39m>"
    },
    {
      "type": "gpu",
      "key": "  \u001b[34m├─ 󰢮 GPU \u001b[39m>",
      "hideType": "none"
    },
    {
      "type": "memory",
      "key": "  \u001b[34m└─ 󰑭 RAM \u001b[39m>"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
